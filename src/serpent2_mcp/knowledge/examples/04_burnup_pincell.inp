set title "PWR pin cell - burnup with depletion zone division"

surf fuel_r  cylz 0.0 0.0 0.4095
surf clad_r  cylz 0.0 0.0 0.4750
surf cell_px px 0.63
surf cell_nx px -0.63
surf cell_py py 0.63
surf cell_ny py -0.63

cell fuel    0 fuel    -fuel_r
cell clad    0 zirc    -clad_r  fuel_r
cell water   0 water   -cell_px cell_nx -cell_py cell_ny clad_r
cell outside 0 outside  cell_px cell_nx  cell_py cell_ny

therm lwtr.20t lwj3.20t

mat fuel -10.297 burn 1
92235.03c -0.0397
92238.03c -0.8418
8016.03c  -0.1185

mat zirc -6.56
40000.03c -0.982
50000.03c -0.018

mat water -0.7403 moder lwtr.20t
1001.03c -0.1119
8016.03c -0.8881

set bc 2
set pop 3000 50 200

% --- Burnup: divide the fuel into 10 radial zones, set volumes ---------
div fuel sep 10
set mvol fuel 0 214.4

% --- Normalisation: 150 W per pin, cumulative burnup points ------------
set power 150
dep butot 0.5 1 2 5 10 20 30 40 50

% --- Write restart file and burned compositions ------------------------
set rfw 1 "pwr.wrk"
set printm 1

set acelib "PATH/TO/data.xsdata"
set declib "PATH/TO/sss_endfb7.dec"
set nfylib "PATH/TO/sss_endfb7.nfy"
