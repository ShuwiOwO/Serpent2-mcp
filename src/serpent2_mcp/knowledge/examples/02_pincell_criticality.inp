set title "PWR pin cell - criticality (k-eff)"

% --- Surfaces ----------------------------------------------------------
surf fuel_r  cylz 0.0 0.0 0.4095
surf clad_r  cylz 0.0 0.0 0.4750
surf cell_px px 0.63
surf cell_nx px -0.63
surf cell_py py 0.63
surf cell_ny py -0.63

% --- Cells -------------------------------------------------------------
cell fuel    0 fuel    -fuel_r
cell clad    0 zirc    -clad_r  fuel_r
cell water   0 water   -cell_px cell_nx -cell_py cell_ny clad_r
cell outside 0 outside  cell_px cell_nx  cell_py cell_ny

% --- Materials (negative values = mass densities/fractions) ------------
mat fuel -10.297
92235.03c -0.0397
92238.03c -0.8418
8016.03c  -0.1185

mat zirc -6.56
40000.03c -0.982
50000.03c -0.018

therm lwtr.20t lwj3.20t
mat water -0.7403 moder lwtr.20t
1001.03c -0.1119
8016.03c -0.8881

% --- Criticality source: 10000 neutrons, 100 active generations --------
set bc 2
set pop 10000 100 500

set acelib "PATH/TO/data.xsdata"
