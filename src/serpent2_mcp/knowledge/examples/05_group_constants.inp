set title "PWR pin cell - homogenised group constants (8 groups, critical spectrum)"

surf fuel_r  cylz 0.0 0.0 0.4095
surf clad_r  cylz 0.0 0.0 0.4750
surf cell_px px 0.63
surf cell_nx px -0.63
surf cell_py py 0.63
surf cell_ny py -0.63

cell fuel    0 fuel    -fuel_r
cell clad    0 zirc    -clad_r  fuel_r
cell water   0 water   -cell_px cell_nx -cell_py cell_ny clad_r
cell outside 0 outside  cell_px cell_nx  cell_py cell_ny

therm lwtr.20t lwj3.20t

mat fuel -10.297
92235.03c -0.0397
92238.03c -0.8418
8016.03c  -0.1185

mat zirc -6.56
40000.03c -0.982
50000.03c -0.018

mat water -0.7403 moder lwtr.20t
1001.03c -0.1119
8016.03c -0.8881

set bc 2
set pop 5000 100 500

% --- Group constant generation -----------------------------------------
set gcu 0          % root universe (single pin cell)
set nfg 8          % built-in 8-group macro structure
set fum -1         % critical spectrum with default micro-group structure

set acelib "PATH/TO/data.xsdata"
